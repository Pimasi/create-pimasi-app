# Baked into the mobile app by `npm run build:cordova` — copy to `.env.cordova`
# and ask teammates for the real values. The static export cannot reach a
# localhost API from a device, so both URLs must point at remote hosts.
NEXT_PUBLIC_API_URL="https://api.example.com"
NEXT_PUBLIC_PUBLIC_WEB_URL="https://your-web-url.example.com"
