# --- Development target ---
FROM node:lts-slim AS dev
WORKDIR /app
COPY package*.json ./
COPY apps/shared/lib/package.json apps/shared/lib/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY apps/shared/lib/ apps/shared/lib/
WORKDIR /app/apps/web
COPY apps/web/ .

# --- Production build ---
FROM dev AS build
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_API_URL
ENV NODE_ENV=production
RUN npm --workspace pimasi-web run build

# --- Production serve ---
FROM nginx:alpine AS prod
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY --from=build /app/apps/web/nginx.conf /etc/nginx/conf.d/default.conf
