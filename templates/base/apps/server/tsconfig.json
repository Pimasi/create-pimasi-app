{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "types": ["node"], // TS 6.0 changed the `types` default to [] (was: all @types/*)
        "paths": {
            "@pimasi/lib": ["../shared/lib/src/index.ts"],
            "@pimasi/lib/*": ["../shared/lib/src/*"]
        },
        "preserveSymlinks": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "noImplicitAny": false,
        "module": "esnext",
        "skipLibCheck": true,
        "target": "es2025",
        "lib": ["es2025", "ESNext.Collection", "ESNext.Temporal"],
        "noEmit": true,
        "pretty": true,
        "strict": true
    },
    "exclude": ["node_modules", "dist"]
}
