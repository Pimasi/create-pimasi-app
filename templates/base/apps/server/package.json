{
    "name": "pimasi-server",
    "version": "1.0.0",
    "author": "Pimasi LTD",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "pm2": "pm2-runtime start process.config.js",
        "build": "tsc -p tsconfig.build.json && rolldown -c rolldown.config.ts",
        "type-check": "tsc -p tsconfig.build.json",
        "build:clean": "rm -rf dist && npm run build",
        "build:watch": "tsc -p tsconfig.build.json --watch",
        "watch": "node --watch-path=./src --import tsx",
        "dev:backend": "npm run watch -- src/backend.ts",
        "start": "npm run pm2",
        "dev": "npm run pm2",
        "test": "vitest run"
    },
    "bin": {
        "run": "./src/cli.ts"
    },
    "dependencies": {
        "@pimasi/lib": "^0.1.0",
        "@pimasi/utils": "^1.1.0",
        "@sendgrid/mail": "^8.1.6",
        "@types/cors": "^2.8.19",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.6.2",
        "@types/yargs": "^17.0.35",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "firebase-admin": "^14.4.0",
        "jsonwebtoken": "^9.0.3",
        "lodash": "^4.18.1",
        "rolldown": "^1.3.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "ulid": "^3.0.2",
        "vitest": "^5.0.1",
        "yargs": "^18.2.0"
    }
}
