{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "noImplicitAny": false,
        "module": "esnext",
        "skipLibCheck": true,
        "target": "es2025",
        "noEmit": true,
        "isolatedModules": true,
        "pretty": true,
        "strict": true
    },
    "include": ["src"]
}
