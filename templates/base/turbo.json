{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "build:cordova": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                "cordova/www/**"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env.cordova"
            ],
            "env": [
                "VITE_*"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "type-check": {
            "dependsOn": [
                "^build"
            ]
        }
    }
}
